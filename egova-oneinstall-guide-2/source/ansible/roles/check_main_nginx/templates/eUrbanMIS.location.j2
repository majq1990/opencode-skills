location /eUrbanMIS {
    set_by_lua_block $serverName {
        local mappings = require "egova.mappings.mappings"
        return mappings.match_v2(ngx.var.uri, "{{ target_service }}")
    }
    if ($uri ~* "/eUrbanMIS(/.*$)") {
      set $api_path $1;
    }
    proxy_pass http://$serverName/$serverName$api_path$is_args$args;
    proxy_connect_timeout 5;
    send_timeout 10;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_cookie_path  /{{ target_service }} /eUrbanMIS;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header Cookie $new_cookie;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP  $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;
    add_header Cache-Control max-age=0;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    add_header Accept-Ranges bytes;
    if ( $uri ~ "\.(gif|jpg|jpeg|bmp|png|ico|zip|pdf|svg|mp3|swf|cur|woff|woff2|eot|ttf|mp3|mp4|swf|webm)$" ){
      add_header Cache-Control max-age=3600000;
    }
    if ( $uri ~ "\.(html|js|css|txt)$" ){
      add_header Cache-Control max-age=3600;
    }
    add_header x-frame-options SAMEORIGIN;
}

location /test/eUrbanMIS {
    default_type text/html;
    set $serverName "{{ target_service }}";
    set $ags $args;
    if ($request_uri ~* "/test/eUrbanMIS(/.*$)") {
      set  $path_and_params $1;
    }
    content_by_lua_block {
        local mappings = require "egova.mappings.mappings"
        ngx.var.serverName = mappings.match_v2(ngx.var.uri, ngx.var.serverName)
        local result = "src=>"..ngx.var.uri.."</br>upstream=>"..ngx.var.serverName.."</br>target=>"..ngx.var.serverName..ngx.var.path_and_params
        ngx.say(result)
    }
}
location = /eUrbanMIS/socket {
    #root   /egova;
    proxy_pass http://{{ target_service }}/{{ target_service }}/socket;
    proxy_set_header           Host $host;
    proxy_set_header  X-Real-IP  $remote_addr;
    proxy_set_header           X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    client_max_body_size  200m;
    index  index.html index.htm;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3000;
}
