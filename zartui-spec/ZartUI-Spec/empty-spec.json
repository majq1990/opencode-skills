{
  "name": "empty-spec",
  "version": "1.0.0",
  "description": "ZartUI 缺省页规范，含图标库总览及六种场景示例",

  "icon_library": {
    "display_size": "120px × 120px",
    "resolution": "@2x 高清版本",
    "base_path": "数据展示-缺省页/",
    "series": [
      {
        "id": "no-image",
        "label": "无图片系列",
        "count": 10,
        "files": ["无图片@2x.png", "无图片@2x(1).png", "无图片@2x(2).png", "无图片@2x(3).png", "无图片@2x(4).png", "无图片@2x(5).png", "无图片@2x(6).png", "无图片@2x(7).png", "无图片@2x(8).png", "无图片@2x(9).png"]
      },
      {
        "id": "no-comment",
        "label": "无评论系列",
        "count": 9,
        "files": ["无评论@2x.png", "无评论@2x(1).png", "无评论@2x(2).png", "无评论@2x(3).png", "无评论@2x(4).png", "无评论@2x(6).png", "无评论@2x(7).png", "无评论@2x(8).png"]
      },
      {
        "id": "no-data",
        "label": "暂无数据系列",
        "count": 29,
        "files": ["无评论备份@2x.png", "无评论备份 2@2x.png", "无评论备份 3@2x.png", "无评论备份 4@2x.png", "无评论备份 5@2x.png", "无评论备份 6@2x.png", "无评论备份 7@2x.png", "无评论备份 8@2x.png", "无评论备份 9@2x.png", "无评论备份 10@2x.png", "无评论备份 11@2x.png", "无评论备份 12@2x.png", "无评论备份 13@2x.png", "无评论备份 14@2x.png", "无评论备份 15@2x.png", "无评论备份 16@2x.png", "无评论备份 17@2x.png", "无评论备份 18@2x.png", "无评论备份 19@2x.png", "无评论备份 20@2x.png", "无评论备份 21@2x.png", "无评论备份 22@2x.png", "无评论备份 23@2x.png", "无评论备份 24@2x.png", "无评论备份 25@2x.png", "无评论备份 26@2x.png", "无评论备份 27@2x.png", "无评论备份 28@2x.png", "无评论备份 29@2x.png"]
      },
      {
        "id": "others",
        "label": "其他场景图标",
        "files": [
          { "file": "无审批@2x.png", "label": "无审批" },
          { "file": "无搜索结果@2x.png", "label": "无搜索结果" },
          { "file": "无消息@2x.png", "label": "无消息" }
        ]
      }
    ]
  },

  "demo_container": {
    "layout": "flex-direction: column; align-items: center; justify-content: center",
    "padding": "48px 0",
    "gap": "12px",
    "border": "1px solid #E9ECF2",
    "border_radius": "4px"
  },

  "demo_image": {
    "width": "120px",
    "height": "120px",
    "resolution": "@2x"
  },

  "demo_title": {
    "font_size": "14px",
    "font_weight": "400",
    "color": "#223355"
  },

  "demo_buttons": {
    "common": {
      "height": "32px",
      "padding": "0 16px",
      "border": "1px solid #DDE1EB",
      "background": "#FFFFFF",
      "font_size": "14px",
      "margin_top": "4px",
      "hover_border": "#3388FF",
      "hover_background": "#F0F9FF",
      "transition": "border-color 0.15s, background 0.15s, color 0.15s"
    },
    "pill": {
      "label": "全圆角按钮",
      "border_radius": "100px",
      "color": "#3388FF",
      "usage": "暂无内容场景（+ 新增）"
    },
    "rect": {
      "label": "矩形按钮",
      "border_radius": "4px",
      "color": "#223355",
      "usage": "无评论（发表评论）、无图片（上传图片）"
    }
  },

  "scenarios": [
    {
      "id": "no-content",
      "label": "暂无内容",
      "icon": "暂无内容@2x.png",
      "title": "暂无内容",
      "button": { "text": "+ 新增", "type": "pill" }
    },
    {
      "id": "no-search-result",
      "label": "无搜索结果",
      "icon": "无搜索结果@2x.png",
      "title": "无搜索结果",
      "button": null
    },
    {
      "id": "no-message",
      "label": "无消息",
      "icon": "无消息@2x.png",
      "title": "暂无消息",
      "button": null
    },
    {
      "id": "no-approval",
      "label": "无审批",
      "icon": "无审批@2x.png",
      "title": "暂无审批",
      "button": null
    },
    {
      "id": "no-comment",
      "label": "无评论",
      "icon": "无评论@2x.png",
      "title": "暂无评论",
      "button": { "text": "发表评论", "type": "rect" }
    },
    {
      "id": "no-image",
      "label": "无图片",
      "icon": "无图片@2x.png",
      "title": "暂无图片",
      "button": { "text": "上传图片", "type": "rect" }
    }
  ]
}
