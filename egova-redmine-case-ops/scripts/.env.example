# 复制本文件为同目录下的 .env.local，填入你自己的 Redmine API Key 即可。
#
#   cp scripts/.env.example scripts/.env.local
#   vi scripts/.env.local
#
# 获取 API Key：登录 Redmine → 右上角「个人账户」 → 右侧「API 访问密钥」 → 「显示」/「生成」
#
# 注意：.env.local 是本机私密文件，不要提交到 git、不要发给别人。

# 必填：你自己的 Redmine API Key（40 位左右）
export REDMINE_API_KEY="在这里粘贴你的 API Key"

# Redmine 地址（默认就是下面这个，内网/云环境不同才需要改）
export REDMINE_BASE_URL="https://faq.egova.com.cn:7787"

# 自签名证书环境需要跳过 SSL 校验，置为 true
export REDMINE_INSECURE_SKIP_VERIFY=true
