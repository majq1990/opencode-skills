stat_conn = {
    "host": "{{ vars[stat_db_prefix][stat_db_key].ip }}",
    "port": {{ vars[stat_db_prefix][stat_db_key].port }},
    "db": "cgdbstat",
    "user": "{{ vars[stat_db_prefix][stat_db_key].username }}",
    "password": "{{ vars[stat_db_prefix][stat_db_key].password }}",
    "charset": "utf8"
}
