    "host": "{{ vars[biz_db_prefix][biz_db_key].ip }}",
    "port": {{ vars[biz_db_prefix][biz_db_key].port }},
    "db": "cgdb",
    "user": "{{ vars[biz_db_prefix][biz_db_key].username }}",
    "password": "{{ vars[biz_db_prefix][biz_db_key].password }}",
    "charset": "utf8"
}
