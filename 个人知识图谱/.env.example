# Knowledge Graph Skill 配置模板
# 复制为 .env 后填入真实密钥；.env 已加入 .gitignore，不会被提交

# ============================================================
# LLM: DeepSeek（OpenAI 兼容）
# ============================================================
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_BINDING_API_KEY=sk-REPLACE_ME

# ============================================================
# Embedding: SiliconFlow BAAI/bge-m3（OpenAI 兼容）
# bge-m3 维度 = 1024；一旦写入图谱不可更换
# ============================================================
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MAX_TOKEN_SIZE=8192

# ============================================================
# Neo4j（图存储）—— 复用本机 neo4j-kg 容器
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123

# ============================================================
# 共享存储 —— 所有客户端（Claude Code / opencode / workbuddy / atomcode）
# 都指向同一个目录，确保向量索引/KV/文档状态共享
# ============================================================
RAG_STORAGE_DIR=C:\Users\majq1\kg-data

# ============================================================
# LightRAG Server
# ============================================================
LIGHTRAG_PORT=9621
LIGHTRAG_HOST=0.0.0.0

# 后端存储绑定
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# 切片参数
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_ASYNC=8
MAX_TOKENS=32768
