{
  "name": "audio-viewer-spec",
  "version": "1.0.0",
  "description": "ZartUI 音频预览规范，弹窗式播放，支持列表切换与纯播放两种形态",

  "overlay": {
    "position": "fixed",
    "inset": "0",
    "background": "rgba(0,0,0,0.4)",
    "z_index": 2000,
    "interactions": {
      "click_mask": "关闭弹窗",
      "esc": "关闭弹窗",
      "space": "播放/暂停"
    }
  },

  "dialog": {
    "width": "520px",
    "border_radius": "4px",
    "background": "#FFFFFF",
    "box_shadow": "0 2px 50px 0 rgba(0,67,202,0.2)",
    "variants": [
      {
        "id": "with-list",
        "label": "弹窗1：含音频列表",
        "height": "467px"
      },
      {
        "id": "player-only",
        "label": "弹窗2：纯播放",
        "height": "206px",
        "note": "仅保留标题栏和播放控制区，无音频列表"
      }
    ]
  },

  "header": {
    "height": "56px",
    "padding": "0 20px",
    "border_bottom": "1px solid #F5F7FA",
    "title": {
      "font_size": "14px",
      "font_weight": "500",
      "color": "#081126"
    },
    "close_btn": {
      "size": "28px",
      "border_radius": "4px",
      "color": "#A8B4C8",
      "hover_color": "#6B7A99",
      "hover_background": "#F5F7FA"
    }
  },

  "player": {
    "padding": "24px 20px 20px",
    "layout": "纵向居中，gap 12px",

    "controls": {
      "layout": "横向排列，gap 16px，水平居中",
      "prev_btn": {
        "size": "32px",
        "shape": "圆形",
        "background": "#F0F9FF",
        "hover_background": "#ddf0ff",
        "icon": "面状后退图标，16px，颜色 #3388FF，圆润风格"
      },
      "play_pause_btn": {
        "size": "56px",
        "shape": "圆形",
        "background": "#3388FF",
        "hover_background": "#2167D9",
        "hover_transform": "scale(1.05)",
        "box_shadow": "0 4px 16px rgba(51,136,255,0.4)",
        "icon": "面状圆润播放/暂停图标，28px，颜色 #FFFFFF"
      },
      "next_btn": {
        "size": "32px",
        "shape": "圆形",
        "background": "#F0F9FF",
        "hover_background": "#ddf0ff",
        "icon": "面状前进图标，16px，颜色 #3388FF，圆润风格"
      }
    },

    "progress_row": {
      "layout": "横向，align-items: center，gap 10px",
      "current_time": {
        "font_size": "12px",
        "color": "#A8B4C8",
        "min_width": "36px",
        "align": "左对齐"
      },
      "track": {
        "flex": 1,
        "height": "3px",
        "background": "#F5F7FA",
        "border_radius": "2px",
        "interaction": "点击跳转进度"
      },
      "progress_bar": {
        "background": "#3388FF",
        "border_radius": "2px"
      },
      "total_time": {
        "font_size": "12px",
        "color": "#A8B4C8",
        "min_width": "36px",
        "align": "右对齐"
      }
    }
  },

  "audio_list": {
    "description": "仅弹窗1（含列表形态）显示",
    "padding": "0 20px 16px",
    "gap": "8px",
    "scrollbar": {
      "width": "4px",
      "thumb_color": "#DDE1EB",
      "border_radius": "2px"
    },

    "item": {
      "width": "480px",
      "height": "60px",
      "border_radius": "4px",
      "padding": "0 12px",
      "gap": "12px",
      "states": {
        "default": {
          "background": "#F5F7FA"
        },
        "hover": {
          "background": "#eaf4ff"
        },
        "active": {
          "background": "#F0F9FF"
        }
      },

      "icon": {
        "size": "40px",
        "color": "#6F5CFF",
        "style": "面状文件图标（带右上角折角），内嵌白色音符（竖线 + 弧形旗 + 倾斜椭圆音符头）"
      },

      "name": {
        "flex": 1,
        "font_size": "13px",
        "overflow": "ellipsis",
        "color_default": "#223355",
        "color_active": "#3388FF"
      },

      "time": {
        "font_size": "12px",
        "color": "#A8B4C8",
        "format_default": "总时长（如 02:18）",
        "format_active": "当前时间 / 总时长（如 00:42 / 02:18）"
      },

      "play_pause_btn": {
        "size": "24px",
        "border_radius": "4px",
        "icon": "面状圆润播放/暂停图标，16px",
        "color_default": "#A8B4C8",
        "color_active": "#3388FF",
        "hover_color": "#3388FF",
        "hover_background": "rgba(51,136,255,0.08)"
      }
    }
  }
}
